{
  "name": "@mcagents-mcp/template",
  "version": "0.0.0",
  "description": "MCP server and CLI for template",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "template": "src/cli.js",
    "template-server": "src/index.js"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "start": "node src/index.js",
    "start:http": "MCP_TRANSPORT=http node src/index.js",
